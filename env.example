# =============================================================================
# AHGA Research Processor - Environment Configuration
# =============================================================================
# SECURITY NOTE: This file contains sensitive configuration.
# NEVER commit the actual .env file to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Security Configuration (REQUIRED for production)
# -----------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl_rand_hex_32

# -----------------------------------------------------------------------------
# API Keys (REQUIRED - set these via environment variables)
# -----------------------------------------------------------------------------
# Google API Key for embeddings and Gemini LLM
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# NCBI API Key for PubMed access (optional but recommended for higher rate limits)
NCBI_API_KEY=your_ncbi_api_key_here

# -----------------------------------------------------------------------------
# Execution Mode Configuration
# -----------------------------------------------------------------------------
# Options: 'local' (default) or 'distributed'
EXECUTION_MODE=local

# -----------------------------------------------------------------------------
# ChromaDB Configuration
# -----------------------------------------------------------------------------
# For distributed mode: IP address of Mystery machine running ChromaDB server
CHROMA_HOST=192.168.1.101
CHROMA_PORT=8000

# -----------------------------------------------------------------------------
# LLM Configuration
# -----------------------------------------------------------------------------
# Provider options: 'gemini' (Google) or 'local' (vLLM/Ollama)
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-2.0-flash

# For local LLM server (vLLM, TGI, Ollama, etc.)
LLM_API_BASE=http://localhost:11434/v1

# -----------------------------------------------------------------------------
# Embeddings Configuration
# -----------------------------------------------------------------------------
# Options: 'google' (Google API) or 'local' (local endpoint)
EMBEDDINGS_PROVIDER=google
EMBEDDINGS_MODEL_NAME=text-embedding-004

# For local embeddings server
EMBEDDINGS_API_BASE=http://localhost:8001/v1

# -----------------------------------------------------------------------------
# Web Application Configuration (for backend)
# -----------------------------------------------------------------------------
# CORS allowed origins (comma-separated for multiple domains)
ALLOWED_ORIGINS=https://your-domain.com

# Session timeout in hours
SESSION_TIMEOUT_HOURS=2

