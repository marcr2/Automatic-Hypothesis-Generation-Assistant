# Execution Mode Configuration
# Options: 'local' (default) or 'distributed'
EXECUTION_MODE=local

# ChromaDB Configuration
# For distributed mode: IP address of Machine 2 running ChromaDB server
CHROMA_HOST=192.168.1.101
CHROMA_PORT=8000

# LLM Configuration
# For distributed mode: Local LLM server endpoint (vLLM, TGI, Ollama, etc.)
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL_NAME=llama3
LLM_PROVIDER=gemini

# Embeddings Configuration
# Options: 'google' (Google API) or 'local' (local endpoint)
EMBEDDINGS_PROVIDER=google
EMBEDDINGS_API_BASE=http://localhost:8001/v1
EMBEDDINGS_MODEL_NAME=nomic-embed-text

# Google API Key (required if EMBEDDINGS_PROVIDER=google or LLM_PROVIDER=gemini)
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

