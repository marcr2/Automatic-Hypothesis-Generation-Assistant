# Mystery Machine Environment Configuration
# RAM-heavy machine with 100GB+ RAM
# Runs: ChromaDB server only

# ============================================================================
# Machine Profile
# ============================================================================
MACHINE_PROFILE=mystery
EXECUTION_MODE=chromadb_server

# ============================================================================
# ChromaDB Server Configuration
# ============================================================================
CHROMA_HOST=0.0.0.0  # Bind to all interfaces to accept connections from M3
CHROMA_PORT=8000     # ChromaDB server port (change if 8000 is in use)
CHROMA_PERSIST_DIRECTORY=/home/user/chromadb_data

# ============================================================================
# Data Paths (Mystery stores only ChromaDB vectors)
# ============================================================================
DATA_ROOT=/home/user/chromadb_data
LOGS_PATH=/home/user/chromadb_logs

# ============================================================================
# ChromaDB Server Settings (Optional)
# ============================================================================
# CHROMA_SERVER_CORS_ALLOW_ORIGINS=["*"]
# CHROMA_SERVER_HOST=0.0.0.0
# CHROMA_SERVER_PORT=8000

