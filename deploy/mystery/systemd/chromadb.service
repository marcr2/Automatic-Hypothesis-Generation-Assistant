[Unit]
Description=ChromaDB Vector Database Server
Documentation=https://docs.trychroma.com
After=network.target

[Service]
Type=simple
User=%USER%
Group=%USER%
WorkingDirectory=/home/user

# Environment variables
Environment="PATH=/home/user/chromadb_venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="CHROMA_PORT=8000"

# ChromaDB server command (port can be overridden by CHROMA_PORT env var)
ExecStart=/home/user/chromadb_venv/bin/chroma run \
  --host 0.0.0.0 \
  --port ${CHROMA_PORT} \
  --path /home/user/chromadb_data

# Restart policy
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/user/chromadb_logs/chromadb.log
StandardError=append:/home/user/chromadb_logs/chromadb_error.log

# Resource limits (optional)
# LimitNOFILE=65536
# LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target

