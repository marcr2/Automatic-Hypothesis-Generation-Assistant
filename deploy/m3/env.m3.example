# M3 Machine Environment Configuration
# Main processing machine with 198GB VRAM and 1.7TB storage
# Runs: Python application, vLLM server, data processing, web interface

# ============================================================================
# SECURITY CONFIGURATION (REQUIRED FOR PRODUCTION)
# ============================================================================
# Generate SECRET_KEY with: openssl rand -hex 32
SECRET_KEY=your_secret_key_here_generate_with_openssl

# Environment mode: "development" or "production"
# Set to "production" to enforce security validations
ENVIRONMENT=production

# ============================================================================
# Machine Profile
# ============================================================================
MACHINE_PROFILE=m3
EXECUTION_MODE=distributed

# ============================================================================
# ChromaDB Configuration (Remote - connects to Mystery)
# ============================================================================
CHROMA_HOST=MYSTERY_IP_ADDRESS  # Replace with Mystery machine's IP (e.g., 192.168.1.100)
CHROMA_PORT=8000

# ============================================================================
# LLM Configuration (Local vLLM on M3)
# ============================================================================
LLM_PROVIDER=local
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL_NAME=meta-llama/Meta-Llama-3.1-70B-Instruct

# ============================================================================
# Embeddings Configuration (Google API)
# ============================================================================
EMBEDDINGS_PROVIDER=google
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# API Keys
# ============================================================================
NCBI_API_KEY=your_ncbi_api_key_here

# ============================================================================
# Data Paths (M3 stores most data)
# ============================================================================
DATA_ROOT=/home/user/AHGA/data
EMBEDDINGS_PATH=/home/user/AHGA/data/embeddings
SCRAPED_DATA_PATH=/home/user/AHGA/data/scraped_data
LOGS_PATH=/home/user/AHGA/data/logs
MODELS_PATH=/home/user/models
TEMP_PATH=/home/user/workspace/temp

# ============================================================================
# vLLM Resource Configuration
# ============================================================================
GPU_MEMORY_UTILIZATION=0.9
MAX_MODEL_LEN=8192
TENSOR_PARALLEL_SIZE=1

# ============================================================================
# Web Application Configuration
# ============================================================================
# CORS allowed origins (your domain)
ALLOWED_ORIGINS=https://your-domain.com

# Session timeout in hours
SESSION_TIMEOUT_HOURS=2

# Rate limiting
MAX_REQUESTS_PER_MINUTE=60
MAX_GENERATIONS_PER_HOUR=5

# ============================================================================
# Optional: HuggingFace Configuration
# ============================================================================
# HF_TOKEN=your_huggingface_token_here  # For gated models like Llama
# HF_HOME=/home/user/models/huggingface_cache

